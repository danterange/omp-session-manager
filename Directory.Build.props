<?xml version="1.0" encoding="utf-8"?>
<Project>
  <PropertyGroup>
    <!-- 发布版本的唯一来源；脚本只更新此值，SDK 自动派生 Assembly/File/Informational Version。 -->
    <Version>1.0.0</Version>
    <!-- 防止调试符号或诊断信息携带本机项目绝对路径。 -->
    <PathMap>$(MSBuildProjectDirectory)=/_/$(MSBuildProjectName)</PathMap>
  </PropertyGroup>
</Project>